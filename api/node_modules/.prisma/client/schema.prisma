generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model Projeto {
  id        Int      @id @default(autoincrement())
  nome      String
  descricao String?
  status    String   @default("Pendente")
  createdAt DateTime @default(now())
}
